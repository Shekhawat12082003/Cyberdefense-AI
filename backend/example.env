# CyberDefense-AI Platform — Example .env
# Copy to .env and fill in your values
# Never commit .env to git

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# ── Blockchain (Core Testnet2) ────────────────────────────
ETH_RPC_URL=https://rpc.test2.btcs.network
CONTRACT_ADDRESS=0x9807Ae60581B38611534d656f6a16AF28B846E17
WALLET_PRIVATE_KEY=your_wallet_private_key
CHAIN_ID=1114

# ── Email Alerts (Gmail) ──────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SENDER=your@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECEIVER=analyst@example.com

# ── Webhook Alerts (Slack / Discord / Teams) ──────────────
# Auto-detects format from URL
# WEBHOOK_URL=https://discord.com/api/webhooks/...
# WEBHOOK_URL=https://hooks.slack.com/services/...

# ── AI Chatbot (first key found is used) ─────────────────
# Gemini 2.0 Flash — FREE — https://aistudio.google.com
GEMINI_API_KEY=

# Groq Llama-3.3-70b — FREE — https://console.groq.com
GROQ_API_KEY=

# OpenAI GPT-4o-mini — PAID
OPENAI_API_KEY=

# ── Threat Intelligence ───────────────────────────────────
# AbuseIPDB — IP reputation — FREE 1000/day
# Get key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan — attacker host fingerprinting — FREE 100/month
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal — file hash scanning 70+ AV engines — FREE 500/day
# Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
